# Configuración de correo para alertas (Nodemailer)
# Opción A (Gmail):
# SMTP_SERVICE=gmail
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion_16_caracteres
#
# Opción B (SMTP estándar: Mailtrap, Brevo, Outlook, etc.):
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=tu_usuario
# SMTP_PASS=tu_password
# SMTP_FROM="ProyectoDACS Alertas" <alertas@proyectodacs.com>
