PORT=8080
HOST=0.0.0.0

# Modo híbrido (BFF en el host): el puerto que publica el compose es 5432,
# salvo que definas DB_PORT en el .env de la raíz (ej. 5433 si tenés un
# PostgreSQL local ocupando el 5432).
DATABASE_URL=postgres://dacs:dacs@localhost:5432/dacs

# Modo todo-en-Docker (servicio bff del compose):
# DATABASE_URL=postgres://dacs:dacs@db:5432/dacs

# CORS: orígenes permitidos separados por coma. En desarrollo, cualquier
# http://localhost:<puerto> ya está permitido sin listarlo.
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development

# Declarada en el compose pero todavía sin uso en el código (no hay cliente AMQP).
RABBITMQ_URL=amqp://dacs:dacs@broker:5672

# Generá uno fuerte y único con: openssl rand -hex 32
JWT_SECRET=genera_un_secreto_fuerte_unico
