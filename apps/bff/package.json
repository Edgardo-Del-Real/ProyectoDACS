{
  "name": "@proyectodacs/bff",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Backend For Frontend de ProyectoDACS — única API que consume el frontend",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2"
  }
}
