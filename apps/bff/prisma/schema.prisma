generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  AGRICULTOR
  COOPERATIVA
  TECNICO
}

model Usuario {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  nombre       String?
  rol          RolUsuario  @default(AGRICULTOR)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  parcelas     Parcela[]
}

model Parcela {
  id         String            @id @default(cuid())
  userId     String
  nombre     String?
  // GeoJSON del polígono (Feature o Polygon). Prisma Postgres no mapea geometry nativo;
  // PostGIS queda disponible vía $queryRaw cuando se necesite ST_Area/ST_Contains.
  poligono   Json
  hectareas  Float
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  usuario    Usuario           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campanias  CampaniaCultivo[]
  pronostico PronosticoClima?

  @@index([userId])
}

model CampaniaCultivo {
  id            String   @id @default(cuid())
  parcelaId     String
  cultivo       String
  campania      String
  rindeReal     Float?
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  parcela       Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)

  @@index([parcelaId])
}

// Cache de pronóstico del clima (Open-Meteo) por parcela.
// Un registro por parcela con los 7 días de pronóstico.
// fetchedAt marca cuándo se obtuvo; TTL 3 horas (RNF-08).
model PronosticoClima {
  id        String   @id @default(cuid())
  parcelaId String   @unique
  datos     Json     // Array de { fecha, tempMax, tempMin, precipitacion }
  fetchedAt DateTime @default(now())
  parcela   Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
}

model Precio {
  id        String   @id @default(cuid())
  cultivo   String
  fecha     DateTime @db.Date
  fuente    String
  valor     Float
  createdAt DateTime @default(now())

  @@unique([cultivo, fecha, fuente])
  @@index([cultivo, fecha])
}

// Catálogo de cultivos agrícolas argentinos (Fase 2 / US-08 / US-09)
model Cultivo {
  id              String          @id @default(cuid())
  nombre          String          @unique
  familiaBotanica String          // ej: "Leguminosa", "Gramínea", "Asterácea"
  cicloDias       Int             // Días promedio del ciclo (ej: 140)
  tempMinCritica  Float           // Temperatura umbral de helada (°C)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  reglasOrigen    ReglaRotacion[] @relation("CultivoAnterior")
  reglasDestino   ReglaRotacion[] @relation("CultivoSiguiente")

  @@index([familiaBotanica])
}

// Reglas de rotación agronómica y efectos sobre el suelo (Fase 2 / US-09)
model ReglaRotacion {
  id                  String   @id @default(cuid())
  cultivoAnteriorId   String
  cultivoSiguienteId  String
  aniosEsperaMin      Int      @default(0) // Años de espera recomendados
  efectoSuelo         String   // Justificación técnica según pautas INTA
  prioridadSugerencia Int      @default(1) // 1 a 5 para el motor de recomendación
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cultivoAnterior     Cultivo  @relation("CultivoAnterior", fields: [cultivoAnteriorId], references: [id], onDelete: Cascade)
  cultivoSiguiente    Cultivo  @relation("CultivoSiguiente", fields: [cultivoSiguienteId], references: [id], onDelete: Cascade)

  @@unique([cultivoAnteriorId, cultivoSiguienteId])
  @@index([cultivoAnteriorId])
  @@index([cultivoSiguienteId])
}

// Parámetros económicos para cálculo de margen bruto y simulación (Fase 2 / US-10)
model ParametroEconomico {
  id                String   @id @default(cuid())
  cultivo           String
  retencionPct      Float    // Derechos de exportación (%)
  costoPorHa        Float    // Costo directo estimado en USD/ha
  fechaVigenteDesde DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([cultivo])
}
