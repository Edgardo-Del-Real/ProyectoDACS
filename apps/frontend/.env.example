# Copiá este archivo a .env.local y completá los valores para tu entorno.
# Vite expone al cliente únicamente las variables con prefijo VITE_.

# Nombre de la aplicación
VITE_APP_NAME=dacs-showcase

# URL base del backend (cliente-servidor), SIN /api: las vistas arman las rutas como `${VITE_API_URL}/api/...`
VITE_API_URL=http://localhost:8080
