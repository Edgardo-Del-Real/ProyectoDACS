{
  "name": "proyectodacs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo de ProyectoDACS — Sistema de Apoyo a Pequeños Agricultores (TP Cliente-Servidor)",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
